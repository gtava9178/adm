{
  "entities": {
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private user account data including PII and appearance preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "phone": { "type": "string", "description": "Optional phone number" },
        "themeMode": { "type": "string", "enum": ["system", "light", "dark"] },
        "chatWallpaper": { "type": "string", "description": "Selected wallpaper preset key" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "themeMode", "chatWallpaper", "createdAt", "updatedAt"]
    },
    "DirectoryProfile": {
      "title": "DirectoryProfile",
      "description": "Public non-PII profile for contact search and online presence",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string", "description": "Verified Yemeni phone number" },
        "bio": { "type": "string" },
        "avatarData": { "type": "string" },
        "online": { "type": "boolean" },
        "discoverable": { "type": "boolean" },
        "hideLastSeen": { "type": "boolean" },
        "hideReadReceipts": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "username", "online", "discoverable", "hideLastSeen", "hideReadReceipts", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct or group conversation metadata",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["direct", "group"] },
        "title": { "type": "string" },
        "avatarData": { "type": "string" },
        "memberUids": { "type": "array" },
        "adminUids": { "type": "array" },
        "createdBy": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageType": { "type": "string", "enum": ["text", "image", "audio", "file", "none"] },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageStatus": { "type": "string", "enum": ["sent", "delivered", "read", "none"] },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCounts": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "memberUids", "adminUids", "createdBy", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message inside a chat thread",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "memberUids": { "type": "array" },
        "type": { "type": "string", "enum": ["text", "image", "audio", "file"] },
        "text": { "type": "string" },
        "mediaData": { "type": "string" },
        "mediaName": { "type": "string" },
        "mediaMime": { "type": "string" },
        "mediaSizeBytes": { "type": "integer" },
        "audioDurationSec": { "type": "integer" },
        "replyToMessageId": { "type": "string" },
        "replyToSenderName": { "type": "string" },
        "replyToPreview": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "readBy": { "type": "array" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "memberUids", "type", "text", "status", "readBy", "deleted", "createdAt", "updatedAt"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Live typing indicator for a chat participant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "typing": { "type": "boolean" },
        "memberUids": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "typing", "memberUids", "updatedAt"]
    },
    "StoryItem": {
      "title": "StoryItem",
      "description": "24-hour disappearing text or image status story",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image"] },
        "text": { "type": "string" },
        "mediaData": { "type": "string" },
        "backgroundColorHex": { "type": "integer" },
        "discoverable": { "type": "boolean" },
        "viewerUids": { "type": "array" },
        "expiresAtEpochMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "authorName", "type", "text", "backgroundColorHex", "discoverable", "viewerUids", "expiresAtEpochMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Private owner-only user settings and PII"
    },
    "/directory/{userId}": {
      "schema": { "$ref": "#/entities/DirectoryProfile" },
      "description": "Public non-PII directory profiles for chat discovery and presence"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Direct and group chat threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a chat thread"
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/TypingStatus" },
      "description": "Real-time typing state per chat member"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/StoryItem" },
      "description": "24-hour user status stories"
    }
  }
}
