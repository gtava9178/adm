rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidPrivateUser(data, userId) {
      return data.userId is string && data.userId == userId &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             data.themeMode is string && data.themeMode in ['system', 'light', 'dark'] &&
             data.chatWallpaper is string && data.chatWallpaper.size() >= 1 && data.chatWallpaper.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidDirectoryUser(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('avatarData' in data) || (data.avatarData is string && data.avatarData.size() <= 350000)) &&
             data.online is bool &&
             data.discoverable is bool &&
             data.hideLastSeen is bool &&
             data.hideReadReceipts is bool &&
             (!('lastSeen' in data) || isValidTimestamp(data.lastSeen)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidChat(data) {
      return data.type is string && data.type in ['direct', 'group'] &&
             data.title is string && data.title.size() <= 100 &&
             (!('avatarData' in data) || (data.avatarData is string && data.avatarData.size() <= 350000)) &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string &&
             data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 20 && data.adminUids[0] is string &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageType' in data) || (data.lastMessageType is string && data.lastMessageType in ['text', 'image', 'audio', 'file', 'none'])) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageStatus' in data) || (data.lastMessageStatus is string && data.lastMessageStatus in ['sent', 'delivered', 'read', 'none'])) &&
             (!('lastMessageAt' in data) || isValidTimestamp(data.lastMessageAt)) &&
             (!('unreadCounts' in data) || data.unreadCounts is map) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidMessage(data, chatId) {
      return data.chatId is string && data.chatId == chatId &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string &&
             data.type is string && data.type in ['text', 'image', 'audio', 'file'] &&
             data.text is string && data.text.size() <= 4000 &&
             (!('mediaData' in data) || (data.mediaData is string && data.mediaData.size() <= 700000)) &&
             (!('mediaName' in data) || (data.mediaName is string && data.mediaName.size() <= 200)) &&
             (!('mediaMime' in data) || (data.mediaMime is string && data.mediaMime.size() <= 100)) &&
             (!('mediaSizeBytes' in data) || (data.mediaSizeBytes is int && data.mediaSizeBytes >= 0 && data.mediaSizeBytes <= 2000000)) &&
             (!('audioDurationSec' in data) || (data.audioDurationSec is int && data.audioDurationSec >= 0 && data.audioDurationSec <= 600)) &&
             (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('replyToSenderName' in data) || (data.replyToSenderName is string && data.replyToSenderName.size() <= 80)) &&
             (!('replyToPreview' in data) || (data.replyToPreview is string && data.replyToPreview.size() <= 200)) &&
             data.status is string && data.status in ['sent', 'delivered', 'read'] &&
             data.readBy is list && data.readBy.size() <= 50 && (data.readBy.size() == 0 || data.readBy[0] is string) &&
             data.deleted is bool &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidTyping(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.typing is bool &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 350000)) &&
             data.type is string && data.type in ['text', 'image'] &&
             data.text is string && data.text.size() <= 500 &&
             (!('mediaData' in data) || (data.mediaData is string && data.mediaData.size() <= 700000)) &&
             data.backgroundColorHex is int &&
             data.discoverable is bool &&
             data.viewerUids is list && data.viewerUids.size() <= 100 && (data.viewerUids.size() == 0 || data.viewerUids[0] is string) &&
             data.expiresAtEpochMs is int && data.expiresAtEpochMs > 0 &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'themeMode', 'chatWallpaper', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'phone', 'themeMode', 'chatWallpaper', 'createdAt', 'updatedAt']) &&
                       isValidPrivateUser(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPrivateUser(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'themeMode', 'chatWallpaper', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /directory/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && existing().discoverable == true;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'username', 'online', 'discoverable', 'hideLastSeen', 'hideReadReceipts', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'username', 'phone', 'bio', 'avatarData', 'online', 'discoverable', 'hideLastSeen', 'hideReadReceipts', 'lastSeen', 'createdAt', 'updatedAt']) &&
                       isValidDirectoryUser(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidDirectoryUser(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'phone', 'bio', 'avatarData', 'online', 'discoverable', 'hideLastSeen', 'hideReadReceipts', 'lastSeen', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && request.auth.uid in existing().memberUids;
      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       incoming().createdBy == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       request.auth.uid in incoming().adminUids &&
                       incoming().keys().hasAll(['type', 'title', 'memberUids', 'adminUids', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['type', 'title', 'avatarData', 'memberUids', 'adminUids', 'createdBy', 'lastMessageText', 'lastMessageType', 'lastMessageSenderId', 'lastMessageStatus', 'lastMessageAt', 'unreadCounts', 'createdAt', 'updatedAt']) &&
                       isValidChat(incoming());
      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChat(incoming()) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().type == existing().type && (
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageType', 'lastMessageSenderId', 'lastMessageStatus', 'lastMessageAt', 'unreadCounts', 'updatedAt']) ||
                         (request.auth.uid in existing().adminUids && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'avatarData', 'memberUids', 'adminUids', 'updatedAt'])) ||
                         (existing().type == 'group' && !(request.auth.uid in incoming().memberUids) && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'adminUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(chatId) && request.auth.uid in existing().adminUids;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid in existing().memberUids;
        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['chatId', 'senderId', 'senderName', 'memberUids', 'type', 'text', 'status', 'readBy', 'deleted', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['chatId', 'senderId', 'senderName', 'memberUids', 'type', 'text', 'mediaData', 'mediaName', 'mediaMime', 'mediaSizeBytes', 'audioDurationSec', 'replyToMessageId', 'replyToSenderName', 'replyToPreview', 'status', 'readBy', 'deleted', 'createdAt', 'updatedAt']) &&
                         isValidMessage(incoming(), chatId) &&
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        allow update: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming(), chatId) &&
                         request.auth.uid in existing().memberUids &&
                         incoming().chatId == existing().chatId &&
                         incoming().senderId == existing().senderId &&
                         incoming().createdAt == existing().createdAt && (
                           (request.auth.uid == existing().senderId && incoming().diff(existing()).affectedKeys().hasOnly(['deleted', 'text', 'mediaData', 'updatedAt'])) ||
                           (request.auth.uid != existing().senderId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'readBy', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && request.auth.uid == existing().senderId;
      }

      match /typing/{userId} {
        allow get, list: if isSignedIn() && request.auth.uid in existing().memberUids;
        allow create, update: if isOwner(userId) &&
                                 isValidId(chatId) &&
                                 isValidId(userId) &&
                                 request.auth.uid in incoming().memberUids &&
                                 incoming().keys().hasAll(['userId', 'displayName', 'typing', 'memberUids', 'updatedAt']) &&
                                 incoming().keys().hasOnly(['userId', 'displayName', 'typing', 'memberUids', 'updatedAt']) &&
                                 isValidTyping(incoming(), userId) &&
                                 exists(/databases/$(database)/documents/chats/$(chatId)) &&
                                 request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        allow delete: if isOwner(userId);
      }
    }

    match /stories/{storyId} {
      allow get, list: if isSignedIn() && existing().discoverable == true;
      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorName', 'type', 'text', 'backgroundColorHex', 'discoverable', 'viewerUids', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'authorAvatar', 'type', 'text', 'mediaData', 'backgroundColorHex', 'discoverable', 'viewerUids', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
                       isValidStory(incoming());
      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         request.auth.uid == existing().userId ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids', 'updatedAt']) && request.auth.uid in incoming().viewerUids)
                       );
      allow delete: if isSignedIn() && isValidId(storyId) && request.auth.uid == existing().userId;
    }
  }
}
